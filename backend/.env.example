# Copia este archivo a .env y completa los valores. No subas .env al repositorio.

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/reservas
DB_USER=reservas
DB_PASSWORD=cambia_esta_contrasena

# Seguridad (JWT). El secreto debe tener al menos 32 caracteres.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRATION_MINUTES=30

# Zona horaria institucional
APP_TIMEZONE=Europe/Madrid

# Primer administrador (se crea al arrancar si no existe ningún administrador)
ADMIN_EMAIL=admin@uni.es
ADMIN_PASSWORD=cambia_esta_contrasena

# Origen permitido para el frontend (CORS)
CORS_ORIGIN=http://localhost:5173
